node_modules/
dist/
.DS_Store
*.local
.vite/

# P2.3 — the local Supabase config. The VALUES are public by design; the file
# is ignored so that rotating the key is not a commit. `.env.example` carries
# what is worth sharing, and explains why the name is `.env.real` and not
# `.env` (Vite auto-loads `.env` in every mode, which would break every other
# verification gate).
.env
.env.local
.env.real

# A76 — the DISPOSABLE TEST ACCOUNT's password, and nothing else. It is the
# only credential this project has ever had on disk, it belongs to an account
# that must be deleted before P3.1, and it must never be committed. See
# supabase/migrations/20260831000200_test_account_grant.sql.
.env.test

# P2.5a — the offline gate builds into these; they are never deployed.
dist-offline-demo/
dist-offline-real/
dist-ground/

# The PMTiles archives. 94 MB of OpenStreetMap-derived basemap: it belongs in
# the public Storage bucket, not in a git repository with a 100 MB file cap.
# `bun run basemap <file> <key>` is how it gets there.
#
# ★ ANCHORED WITH A LEADING SLASH, AND IT HAD TO BE. Un-anchored, `basemap/`
#   matched EVERY directory of that name at any depth — including
#   `docs/screenshots/basemap/`, which is where A83 writes the Haifa captures
#   that are the product owner's own evidence. A rule meant to keep 94 MB out
#   of the repository was quietly keeping the proof out too.
/basemap/

# The archive the deploy pulls from the release asset into the Pages payload
# (ETAT §28). Same 94 MB as `/basemap/` above, staged where Vite will copy it.
/public/basemap/
dist-backdrop/
# A85 — the redraw gate's own build, and the scratch builds used to look at a
# screen. Same reason as every line above: they carry the 94 MB archive.
dist-redraw/
dist-look/
dist-redraw-probe/

# A86 — the overlap gate builds its own copy.
dist-overlap/

# A87 — the freehand gate builds its own copy.
dist-freehand/

# The demo twin, built by the deploy and folded into dist/demo (ETAT §35).
dist-demo/
dist-zones/
